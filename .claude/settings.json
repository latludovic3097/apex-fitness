{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "npx --yes prettier --write --no-error-on-unmatched-pattern \"*.js\" \"*.html\" \"*.css\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}
